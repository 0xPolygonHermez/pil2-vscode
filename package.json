{
  "name": "pil2-language-support",
  "displayName": "PIL2 Language Support",
  "description": "Syntax highlighting and language features for PIL2 DSL",
  "version": "0.0.3",
  "license": "MIT OR Apache-2.0",
  "publisher": "SilentSig",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/pil2-vscode.git"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pil2",
        "aliases": ["PIL2", "pil2"],
        "extensions": [".pil2", ".pil"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pil2",
        "scopeName": "source.pil2",
        "path": "./syntaxes/pil2.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pil2-language-support.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "esbuild": "^0.25.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
