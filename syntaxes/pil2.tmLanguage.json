{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "pil2",
    "patterns": [
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#include"
        },
        {
            "include": "#pragma"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.col.pil2",
                    "match": "\\b(private|const|col|witness|fixed|publictable|public|proofval|airgroupval|airval|aggregate|instance|stage|challenge|args|not|alias|use)\\b"
                },
                {
                    "name": "keyword.types.pil2",
                    "match": "\\b(fe|int|string|expr)\\b"
                },
                {
                    "name": "keyword.function.pil2",
                    "match": "\\b(function|return)\\b"
                },
                {
                    "name": "keyword.control.pil2",
                    "match": "\\b(if|else|for|in|while|do|break|continue|switch|case|default|when|once|final|container|air|proof|airgroup|airtemplate|on)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.pil2",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pil2",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.interpolated.pil2",
                    "begin": "`",
                    "end": "`"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.pil2",
                    "begin": "(\\/\\*)",
                    "end": "(\\*\\/)"
                },
                {
                    "match": "\\/\\/.*n?",
                    "name": "comment.line.pil2"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b([0-9][0-9_]*n?)\\b",
                    "name": "constant.numeric.decimal.pil2"
                },
                {
                    "match": "\\b(0x[0-9A-Fa-f][0-9A-Fa-f_]*n?)\\b",
                    "name": "constant.numeric.hexadecimal.pil2"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "===",
                    "name": "entity.name.function.constraint.pil2"
                },
                {
                    "match": "<==",
                    "name": "entity.name.function.constraint.pil2"
                },
                {
                    "match": "==",
                    "name": "keyword.operator.assignment.pil2"
                },
                {
                    "match": "\\.\\.\\+\\.\\.",
                    "name": "keyword.operator.range.series.arithmetic.pil2"
                },
                {
                    "match": "\\.\\.\\*\\.\\.",
                    "name": "keyword.operator.range.series.geometric.pil2"
                },
                {
                    "match": "\\.\\.\\.",
                    "name": "keyword.operator.range.fill.pil2"
                },
                {
                    "match": "\\.\\.",
                    "name": "keyword.operator.range.pil2"
                },
                {
                    "match": "\\*|-|\\+",
                    "name": "keyword.operator.pil2"
                }
            ]
        },
        "include": {
            "patterns": [
                {
                    "name": "meta.preprocessor.include.pil2",
                    "match": "\\b(include|require)\\b\\s*(\"[^\"]+\"|'[^']+')",
                    "captures": {
                        "1": { "name": "keyword.control.include.pil2" },
                        "2": { "name": "string.quoted.include.pil2" }
                    }
                },
                {
                    "name": "meta.preprocessor.include.template.pil2",
                    "begin": "\\b(include|require)\\b\\s*(`)",
                    "end": "`",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.include.pil2" },
                        "2": { "name": "string.template.begin.pil2" }
                    },
                    "endCaptures": {
                        "0": { "name": "string.template.end.pil2" }
                    },
                    "patterns": [
                        {
                            "name": "constant.other.placeholder.pil2",
                            "match": "\\$\\{[^}]+\\}"
                        },
                        {
                            "name": "string.template.pil2",
                            "match": "[^$`]+"
                        }
                    ]
                }
            ]
        },
        "pragma": {
            "patterns": [
                {
                    "match": "#pragma.*",
                    "name": "pragma.line.pil2"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.reference.pil2",
                    "match": "(\\&[a-zA-Z_][a-zA-Z$_0-9]*)\\b"
                },
                {
                    "name": "decorator.metadata.pil2",
                    "match": "@[a-zA-Z_][a-zA-Z$_0-9]*"
                },
                {
                    "name": "variable.pil2",
                    "match": "\\b([a-zA-Z_][a-zA-Z$_0-9]*)\\b"
                }
            ]
        }
    },
    "scopeName": "source.pil2"
}
